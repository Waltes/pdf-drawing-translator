# 打包产物
build/
dist/
packaging/output/

# 用户数据：配置里有 API key，缓存里有图纸原文和译文，用量记录是个人账单。
# 这三样绝对不能进仓库，也不该出现在任何安装包里。
data/config.json
data/cache.json
data/usage.json
data/selftest.log
data/_ocr_tmp.png
data/prices.json

# API key 的加密备份和安装前的配置备份。源码运行时落在项目根（data 的上一级），
# 打包后落在 %APPDATA%\PDFDrawingTranslator\。里面是密钥，任何情况都不进仓库。
apikey.dat
apikey.dat.tmp
config.bak.json

# 运行日志
启动错误.log
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp

# 验证过程截图（里面有真实图纸，可能涉及客户资料）
验证截图/

# 临时验证脚本与中间产物：跑端到端、比字体、试安装时随手写的，
# 发版前应清掉，别误提交
_tmp_*/
_tmp_*.py
_old_dist/
_tmp_install*/
_tmp_appdata_backup/
_i18n_keys.txt

# 开发时用的那份演示图纸（同样涉及真实项目资料）。
# 公开的示例在 samples/ 里，是另外造的虚构零件。
sample/

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store

# 打包中途的旧产物与调试输出，不进仓库
_old_build/
_exe_st.out
_tmp_*/

# 发版前的对比样本（临时验证用）
_cmp_*.pdf

# 端到端调试脚本与渲染截图，不进仓库
_e2e.py
_v1*.png
_cmp_*.pdf

# 合成检查与调试脚本的产物
_synth/
_dbg*
_fix_new*
_zoom_*.png

# 端到端验证产物
_*.pdf
_*.png
_*.log
_*.pkl

# 临时验证脚本（_t_ 前缀，用完删）
_t_*.py

# 打包中间产物（由 packaging/build_edition.py 生成）
packaging/edition_defs.iss
packaging/_version_info_build.txt

# 压测产物：每轮一份完整 PDF + 明细日志，只在本机看，不进仓库
_stress/

# 批量测试产物：每份图纸的完整译文 + 明细日志，只在本机看
_batch/
_survey/
_ed_bak.json
# _batch.py 切换发行版时留的临时备份。正常情况下它在 atexit 里被删掉，
# 但进程被强杀（改逻辑时中断压测）就会留下来 —— 内容没变，但会一直
# 挂在 git status 里，容易误提交
_edition_backup.json

# 单份图纸的体检与对比图（原/译上下拼图）
_bench/

# 竖排效果验证产物（模拟图、对比裁图）
_vert/

# 斜排角度探测的中间结果（脚本本身进仓库，抽出来的候选清单不进）
_slant_probe.json
