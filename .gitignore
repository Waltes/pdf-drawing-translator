# 打包产物
build/
dist/
packaging/output/

# 用户数据：配置里有 API key，缓存里有图纸原文和译文，用量记录是个人账单。
# 这三样绝对不能进仓库，也不该出现在任何安装包里。
data/config.json
data/cache.json
data/usage.json
data/selftest.log
data/_ocr_tmp.png
data/prices.json

# API key 的加密备份和安装前的配置备份。源码运行时落在项目根（data 的上一级），
# 打包后落在 %APPDATA%\PDFDrawingTranslator\。里面是密钥，任何情况都不进仓库。
apikey.dat
apikey.dat.tmp
config.bak.json

# 运行日志
启动错误.log
*.log

# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/

# 编辑器
.vscode/
.idea/
*.swp

# 验证过程截图（里面有真实图纸，可能涉及客户资料）
验证截图/

# 临时验证脚本与中间产物：跑端到端、比字体、试安装时随手写的，
# 发版前应清掉，别误提交
_tmp_*/
_tmp_*.py
_old_dist/
_tmp_install*/
_tmp_appdata_backup/
_i18n_keys.txt

# 开发时用的那份演示图纸（同样涉及真实项目资料）。
# 公开的示例在 samples/ 里，是另外造的虚构零件。
sample/

# 系统垃圾
Thumbs.db
desktop.ini
.DS_Store
